{
  "name": "webtool",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 3 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webtool",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ]
}
